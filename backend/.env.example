# Copy to backend/.env and fill in, or run ./scripts/init-env.sh, which copies this file and shares
# AMEX_AGENT_TOKEN with the amex-agent repo. Tags: REQUIRED (the app refuses to start without it),
# AUTO (filled by init-env.sh), OPTIONAL (a blank value keeps the default).

# ── Database ─────────────────────────────────────────────────────────────────────
# REQUIRED — matches the bundled docker-compose database (published on 127.0.0.1:5434).
DATABASE_URL=postgresql+psycopg://hfm:hfm@localhost:5434/hfm

# ── Language model (writes the report narrative; numbers never come from it) ─────
# REQUIRED — provider:model, anthropic or openai, e.g. openai:gpt-5-mini.
LLM_MODEL=anthropic:claude-haiku-5-5
# REQUIRED for the chosen provider: the app refuses to start without it.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# TEST-ONLY — leave unset. docker-compose.e2e.yml sets it so the end-to-end test shows a canned
# report and reads no model or key.
# HFM_E2E=true

# ── Card agents ──────────────────────────────────────────────────────────────────
# AUTO — bearer token amex-agent expects; init-env.sh keeps it equal to the agent's own
# APP_A2A_TOKEN. config/agents.yaml names this variable.
AMEX_AGENT_TOKEN=
# OPTIONAL — where amex-agent answers (default http://localhost:8020; compose overrides it).
AMEX_AGENT_URL=http://localhost:8020
# OPTIONAL — where a browser reaches amex-agent, for the page's link to its statements page.
# Default: AMEX_AGENT_URL as set here, in both modes; compose swaps AMEX_AGENT_URL for an
# in-network address but leaves this one a host address.
# AMEX_AGENT_BROWSER_URL=http://localhost:8020
# REQUIRED — path to the amex-agent repo, used to build its image and to launch it in host mode;
# relative paths start at this repo's root (init-env.sh --amex-dir records another path).
AMEX_AGENT_DIR=../../java/amex-agent
# REQUIRED — host folder with the statement PDFs amex-agent reads, normally the statements/ folder
# of that repo (the e2e test uses an empty temporary folder instead); relative paths start at this
# repo's root. Both modes hand it to the agent as APP_STATEMENTS_DIR, over the agent's own .env.
AMEX_STATEMENTS_DIR=../../java/amex-agent/statements

# ── Config files and the page ────────────────────────────────────────────────────
# OPTIONAL — the card-agent list and the monthly budget; relative paths resolve against the
# manager's working directory (the repo root in start.sh --host, /app in the image).
# AGENTS_CONFIG=config/agents.yaml
# BUDGET_CONFIG=config/budget.yaml
# OPTIONAL — folder of the built React page, served at /; unset serves the API only. start.sh
# --host and the image set it.
# HFM_FRONTEND_DIST=frontend/dist

# ── Checkpoints ──────────────────────────────────────────────────────────────────
# OPTIONAL — LangGraph's checkpoint serializer is permissive by default; true blocks any value
# type outside the review's allow-list, logging a warning instead of restoring it. The scripts and
# compose set it; the app itself does not.
LANGGRAPH_STRICT_MSGPACK=true

# ── Logging ──────────────────────────────────────────────────────────────────────
# OPTIONAL — root level (default WARNING) and per-module overrides.
# HFM_LOG_LEVEL=INFO
# HFM_LOG_LEVELS=hfm.application.review_graph=DEBUG
