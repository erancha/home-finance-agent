# Copy to backend/.env and fill in, or run ./scripts/init-env.sh, which copies this file. Tags:
# REQUIRED (the app refuses to start without it), OPTIONAL (a blank value keeps the default).

# ── Database ─────────────────────────────────────────────────────────────────────
# REQUIRED — matches the bundled docker-compose database (published on 127.0.0.1:5434).
DATABASE_URL=postgresql+psycopg://hfm:hfm@localhost:5434/hfm

# ── Language model (writes the report narrative; numbers never come from it) ─────
# REQUIRED — provider:model, anthropic or openai. The model only phrases totals computed in
# code, so the cheapest tier does; anthropic:claude-haiku-5-5 is the Anthropic equivalent.
LLM_MODEL=openai:gpt-5-nano
# REQUIRED — the API key of the provider LLM_MODEL names.
LLM_API_KEY=
# TEST-ONLY — leave unset. docker-compose.e2e.yml sets it so the end-to-end test shows a canned
# report and reads no model or key.
# HFM_E2E=true

# ── Sign in with Google ──────────────────────────────────────────────────────────
# REQUIRED — the OAuth client id of this agent's Google Cloud project (type "Web application",
# authorized JavaScript origin http://localhost:8010). The page signs people in with it, and
# every token the API accepts must be issued to it. docs/sign-in.md walks through the setup.
GOOGLE_CLIENT_ID=
# OPTIONAL — who issues the tokens and where their public keys are published; Google's by
# default. docker-compose.e2e.yml points both at a test issuer and a public key file instead.
# AUTH_ISSUER=https://accounts.google.com
# AUTH_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
# AUTH_PUBLIC_KEY_FILE=

# ── Card agents ──────────────────────────────────────────────────────────────────
# OPTIONAL — the registry of card agents this agent reviews with, one entry per agent with the URL
# it is called at, the URL a browser opens its pages at and the secret it issued to this agent;
# ./scripts/add-card-agent.sh writes it (mode 600, gitignored). Absent or empty, no card agent is
# connected and the page says so. Default: beside this file; compose mounts it at /card-agents.yaml.
# CARD_AGENTS_FILE=backend/card-agents.yaml

# ── Config files and the page ────────────────────────────────────────────────────
# OPTIONAL — the monthly budget; a relative path resolves against the manager's working directory
# (the repo root in start.sh --host, /app in the image).
# BUDGET_CONFIG=config/budget.yaml
# OPTIONAL — folder of the built React page, served at /; unset serves the API only. start.sh
# --host and the image set it.
# HFM_FRONTEND_DIST=frontend/dist

# ── Checkpoints ──────────────────────────────────────────────────────────────────
# OPTIONAL — LangGraph's checkpoint serializer is permissive by default; true blocks any value
# type outside the review's allow-list, logging a warning instead of restoring it. The scripts and
# compose set it; the app itself does not.
LANGGRAPH_STRICT_MSGPACK=true

# ── Logging ──────────────────────────────────────────────────────────────────────
# OPTIONAL — root level (default WARNING) and per-module overrides.
# HFM_LOG_LEVEL=INFO
# HFM_LOG_LEVELS=hfm.application.review_graph=DEBUG
